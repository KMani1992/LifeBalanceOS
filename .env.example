# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Keep-alive cron (server-only; never prefix these with NEXT_PUBLIC_)
# Generate CRON_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=your_random_cron_secret_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App Configuration (Optional)
# Set to your actual domain in production (e.g., https://lifebalanceos.com)
# Used for OAuth redirects. Defaults to localhost:3000 in development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PWA/Push Notifications (Optional)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# AI Configuration (Optional but required for AI coaching endpoints)
# Use either GEMINI_API_KEY or GOOGLE_API_KEY
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_ai_api_key_here
